# Auto-generated Geant4 macro for approximate voxelized material scan
# theta fixed to 0 deg
# z in [-10, 10] cm with prime-number sampling
# phi in [0, 360) deg with prime-number sampling
# eyePosition shifted in 1 mm steps along the ray

/control/verbose 0
/control/matScan/eyePosition 0 0 0 cm

# z = -10.000 cm, phi = 0.000 deg
